<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── Google AdMob (react-native-google-mobile-ads) ──────────────────
	     Real iOS App ID from the AdMob console (Multiflix iOS). Ad-unit IDs +
	     the ADS_ENABLED master switch live in src/config/admob.ts. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-7029440848837237~2986794986</string>
	<!-- NSUserTrackingUsageDescription intentionally OMITTED: the app does not
	     request App Tracking Transparency / track users while ads are disabled,
	     and shipping the string makes App Store Review demand a "Tracking"
	     privacy declaration. When ads go live: add this key back, implement the
	     ATT prompt, and declare tracking in App Store Connect → App Privacy. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
		<!-- TODO: add the full Google-recommended SKAdNetwork identifier list
		     from https://developers.google.com/admob/ios/ios14 for best
		     install attribution. -->
	</array>
